    {
      "id": "3e99a5fd-d726-4b44-94cf-104a6ab9c009",
      "name": "Synthetic data only",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        -360
      ],
      "parameters": {
        "content": "## Healthcare Request Automation — synthetic data only\nFastAPI owns redaction, classification validation, deterministic decisions, review creation and audits. Branches only display the persisted backend decision.\n\nAUTO_PROCESS/REJECT are administrative workflow outcomes, not medical treatment or claim-payment decisions. No LLM credentials are present in n8n.\n\nA processing error includes the created UUID: inspect/process that request; never automatically repeat intake. HTTP retries are disabled.",
        "height": 270,
        "width": 800
      }
    },
    {
      "id": "phase5-process-http",
      "name": "Process with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -120
      ],
      "retryOnFail": false,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://backend:8000/api/v1/requests/' + $json.response_body.request_uuid + '/process' }}",
        "sendBody": false,
        "options": {
          "timeout": 45000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "={{ $('Check backend response').first().json.correlation_id || '' }}"
            }
          ]
        }
      }
