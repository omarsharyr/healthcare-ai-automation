    {
      "id": "phase5-check-processing-response",
      "name": "Check processing response",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const upstream = $input.first().json;\nconst correlation = upstream.headers?.['x-correlation-id'] || null;\nconst created = $('Check backend response').first().json.response_body;\nconst body = upstream.body;\nconst status = Number(upstream.statusCode);\nconst decisions = ['AUTO_PROCESS', 'HUMAN_REVIEW', 'REJECT'];\nif (status === 200 && body && body.request_uuid === created.request_uuid &&\n    body.status === 'processed' && decisions.includes(body.system_decision)) {\n  const response = {persisted: true};\n  for (const key of ['request_uuid', 'category', 'confidence', 'ai_recommendation',\n    'system_decision', 'decision_reason', 'status', 'review_id']) {\n    if (Object.prototype.hasOwnProperty.call(body, key)) response[key] = body[key];\n  }\n  return [{json: {correlation_id: correlation, success: true, response_status: 200, response_body: response}}];\n}\nconst message = typeof upstream.error === 'string' ? upstream.error\n  : String(upstream.error?.message ?? upstream.error?.code ?? '');\nconst timeout = /timeout|timed.?out|ETIMEDOUT|ESOCKETTIMEDOUT/i.test(message);\nreturn [{json: {correlation_id: correlation, success: false, response_status: timeout ? 504 : status === 409 ? 409 : status === 503 ? 503 : 502,\n  response_body: {request_uuid: created.request_uuid, persisted: true,\n    detail: 'Request was created but processing was not confirmed. Check this UUID; do not submit intake again.'}}}];"
      },
