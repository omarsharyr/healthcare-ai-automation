    {
      "id": "agent-scope-and-safety",
      "name": "Scope and safety",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        350,
        -380
      ],
      "parameters": {
        "content": "## Synthetic data only\nFastAPI owns tool authorization, validation, execution, limits and audit. Human Review is a display branch: any review was already created by FastAPI. No approval/rejection tool is exposed.\n\nFallback may have escalated=false and human_action_required=true (for example timeout or missing UUID). Return Result preserves this flag; a human must investigate. Audit node documents the backend commit; it does not create a second audit. No prompts are pinned or saved intentionally.",
        "height": 280,
        "width": 870
      }
    }
