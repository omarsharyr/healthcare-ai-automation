      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// Only validate the transport envelope. FastAPI owns all field/business validation.\nconst body = $input.first().json.body;\nif (body === null || typeof body !== 'object' || Array.isArray(body)) {\n  return [{ json: { forward: false, response_status: 400,\n    response_body: { detail: 'Expected a JSON object request body' } } }];\n}\n// Keep unknown fields so FastAPI can reject them; identify this orchestration channel.\nreturn [{ json: { forward: true, payload: { ...body, source: 'n8n' } } }];"
      }
    },
    {
      "id": "3e99a5fd-d726-4b44-94cf-104a6ab9c003",
      "name": "Valid JSON object?",
