APP_NAME=AI Healthcare Workflow Automation Platform
APP_ENVIRONMENT=development
APP_VERSION=0.6.0
APP_LOG_LEVEL=INFO
API_PORT=8000

# Set a local development password before starting Compose. No real healthcare data.
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=
POSTGRES_DB=healthcare
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional host-only override. Leave blank to build the URL from POSTGRES_* safely.
# Compose always uses service DNS postgres:5432 and POSTGRES_* (not this URL).
DATABASE_URL=

DB_CONNECT_TIMEOUT=3
DB_POOL_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=3000
DB_STARTUP_ATTEMPTS=15
DB_RETRY_INTERVAL_SECONDS=2
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=30

# Separate disposable test database; never point this at application data.
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_HOST=127.0.0.1
# Optional override. Otherwise tests use POSTGRES credentials and healthcare_test.
TEST_DATABASE_URL=

# Local n8n editor/webhook port. Keep the encryption key stable with the n8n volume.
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC

# Explicit offline demo by default. Set openai and a local key for a real provider.
# Tests always use FakeAIProvider or mocked HTTP, never a paid API.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20

AGENT_MAX_TOOL_CALLS=5
AGENT_TIMEOUT_SECONDS=25
# Local demo capability; disable to deny aggregate review counts.
AGENT_ALLOW_GLOBAL_COUNT=true
